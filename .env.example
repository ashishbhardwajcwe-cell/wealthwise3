# ───────────────────────────────────────────────
# REQUIRED
# ───────────────────────────────────────────────

# Anthropic / Claude API — powers /ai-wealth-planner
ANTHROPIC_API_KEY=sk-ant-...

# ───────────────────────────────────────────────
# RECOMMENDED (site polish + analytics)
# ───────────────────────────────────────────────

NEXT_PUBLIC_SITE_URL=https://planmycashflows.com
NEXT_PUBLIC_GA_ID=G-BNT8QF03F6
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=planmycashflows.com

# ───────────────────────────────────────────────
# Resend — newsletter + PDF download emails
# Without these vars, signups still succeed but no email is sent.
# Required: verify your sending domain in Resend first.
# ───────────────────────────────────────────────
RESEND_API_KEY=
# Optional overrides; defaults shown below
# RESEND_FROM="PlanMyCashflows <hello@planmycashflows.com>"
# RESEND_REPLY_TO=hello@planmycashflows.com
# RESEND_NOTIFY=hello@planmycashflows.com

# ───────────────────────────────────────────────
# Upstash Redis — AI Wealth Planner rate limit + cache
# Without these vars, the API still works but skips rate limiting + cache.
# Limit: 3 snapshots / IP / hour. Cache TTL: 24h.
# ───────────────────────────────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ───────────────────────────────────────────────
# Supabase — optional login on the marketing site (Google + email).
# Use the SAME project as the CashFlow Planner app so accounts are shared.
# Without these, the login button hides itself and the site works as before.
# The anon key is public-safe (protected by Row Level Security).
# ───────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://hbddsvwghboftjsgtate.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ───────────────────────────────────────────────
# Sanity CMS — blog posts, stock analyses, PMS/AIF/unlisted data
# Studio mounted at /studio. Required to publish new content.
# Without these vars, the site falls back to lib/blog-data.ts.
# ───────────────────────────────────────────────
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-09-01
# Viewer-role token used by the site server to fetch content
SANITY_API_TOKEN=
# Shared secret with the Sanity webhook for cache revalidation
SANITY_REVALIDATE_SECRET=

# ───────────────────────────────────────────────
# Optional
# ───────────────────────────────────────────────

# CashFlow Planner App / Topmate
NEXT_PUBLIC_APP_URL=https://wealth.auris8.com
NEXT_PUBLIC_TOPMATE_URL=https://topmate.io/planmycashflows
