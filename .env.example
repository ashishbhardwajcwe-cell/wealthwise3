# ───────────────────────────────────────────────
# REQUIRED
# ───────────────────────────────────────────────

# Anthropic / Claude API — powers /ai-wealth-planner
ANTHROPIC_API_KEY=sk-ant-...

# ───────────────────────────────────────────────
# RECOMMENDED (site polish + analytics)
# ───────────────────────────────────────────────

NEXT_PUBLIC_SITE_URL=https://auriswealth.co
NEXT_PUBLIC_GA_ID=G-BNT8QF03F6
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=auriswealth.co

# ───────────────────────────────────────────────
# Resend — newsletter + PDF download emails
# Without these vars, signups still succeed but no email is sent.
# Required: verify your sending domain in Resend first.
# ───────────────────────────────────────────────
RESEND_API_KEY=
# Optional overrides; defaults shown below
# RESEND_FROM="Auris Wealth <hello@auriswealth.co>"
# RESEND_REPLY_TO=hello@auriswealth.co
# RESEND_NOTIFY=hello@auriswealth.co

# ───────────────────────────────────────────────
# Upstash Redis — AI Wealth Planner rate limit + cache
# Without these vars, the API still works but skips rate limiting + cache.
# Limit: 3 snapshots / IP / hour. Cache TTL: 24h.
# ───────────────────────────────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ───────────────────────────────────────────────
# Optional
# ───────────────────────────────────────────────

# Sanity (blog CMS) — not yet integrated; blog uses /lib/blog-data.ts
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# WealthWise App / Topmate
NEXT_PUBLIC_APP_URL=https://wealth.auris8.com
NEXT_PUBLIC_TOPMATE_URL=https://topmate.io/auris8
